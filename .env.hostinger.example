# The fully qualified domain where the CMS admin will be available. Create an
# A record for this name pointing to the Hostinger VPS before deploy.
CMS_DOMAIN=cms.example.com

# Credentials for the private Nginx Proxy Manager control panel. Use a real
# email address and a strong password; this is not the CMS admin login.
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=replace-with-a-strong-proxy-password
