# Required: use a production MongoDB deployment, such as MongoDB Atlas.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/linkup_cms?retryWrites=true&w=majority

# Required: long random value (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret

# Required: CMS administrator credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required for production media uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Set by docker-compose.hostinger.yml. Keep these values if you run the
# backend independently behind the same CMS domain.
FRONTEND_URL=https://cms.example.com
PUBLIC_API_URL=https://cms.example.com/api

# Optional comma-separated allowlist for extra browser clients, for example a
# staging frontend. FRONTEND_URL above is included automatically.
# ALLOWED_ORIGINS=https://staging-cms.example.com
