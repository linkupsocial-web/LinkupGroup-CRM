# Copy this file to .env.docker, then replace every placeholder.
# Use URI-safe values (letters, numbers, or hex) for Mongo credentials.
MONGO_ROOT_USERNAME=replace_with_root_username
MONGO_ROOT_PASSWORD=replace_with_strong_uri_safe_password

MONGO_APP_USERNAME=replace_with_app_username
MONGO_APP_PASSWORD=replace_with_strong_uri_safe_password
MONGO_DB=linkup_cms

JWT_SECRET=replace_with_existing_jwt_secret
ADMIN_EMAIL=replace_with_existing_admin_email
ADMIN_PASSWORD=replace_with_existing_admin_password

CLOUDINARY_CLOUD_NAME=replace_with_existing_cloud_name
CLOUDINARY_API_KEY=replace_with_existing_api_key
CLOUDINARY_API_SECRET=replace_with_existing_api_secret

PUBLIC_API_URL=http://localhost:8080/api
